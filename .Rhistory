library(DiagrammeR)
install.packages("DiagrammeR")
library(DiagrammeR)
library(dplyr)
# Création du diagramme hiérarchique
create_population_diagram <- function() {
# Définir le style des nœuds
diagram <- grViz("
digraph population_flow {
# Configuration générale
graph [layout = dot, rankdir = TB, bgcolor = white]
# Style des nœuds
node [shape = box, style = 'rounded,filled', fillcolor = lightblue,
fontname = Arial, fontsize = 12, color = steelblue, penwidth = 2]
# Style des arêtes
edge [color = steelblue, penwidth = 2]
# Définition des nœuds
A [label = 'Population']
B [label = 'Population de\\nmoins de 14 ans']
C [label = 'Population en âge\\nde travailler\\n(62.5%)']
D [label = 'Main d\\'oeuvre\\n(55.7%)']
E [label = 'Hors main\\nd\\'oeuvre (44.3%)']
F [label = 'Population en\\nemploi (94.7%)']
G [label = 'Chômage (5.3%)']
H [label = 'Main d\\'oeuvre\\npotentielle (5.7%)']
I [label = 'Population au\\ntravail mais pas en\\nemploi (78.7%)']
J [label = 'Autres individus\\nhors main\\nd\\'oeuvre (15.6%)']
# Définition des connexions
A -> B
A -> C
C -> D
C -> E
D -> F
D -> G
E -> H
E -> I
E -> J
# Définition des rangs pour l'alignement
{rank = same; B; C}
{rank = same; D; E}
{rank = same; F; G; H; I; J}
}
")
return(diagram)
}
# Fonction alternative avec des données personnalisables
create_population_diagram_with_data <- function(data_list) {
# Extraire les pourcentages des données
pop_age_travail <- data_list$pop_age_travail
main_oeuvre <- data_list$main_oeuvre
hors_main_oeuvre <- data_list$hors_main_oeuvre
emploi <- data_list$emploi
chomage <- data_list$chomage
main_oeuvre_pot <- data_list$main_oeuvre_pot
travail_pas_emploi <- data_list$travail_pas_emploi
autres_hors_main <- data_list$autres_hors_main
diagram <- grViz(paste0("
digraph population_flow {
graph [layout = dot, rankdir = TB, bgcolor = white]
node [shape = box, style = 'rounded,filled', fillcolor = lightblue,
fontname = Arial, fontsize = 12, color = steelblue, penwidth = 2]
edge [color = steelblue, penwidth = 2]
A [label = 'Population']
B [label = 'Population de\\nmoins de 14 ans']
C [label = 'Population en âge\\nde travailler\\n(", pop_age_travail, "%)']
D [label = 'Main d\\'oeuvre\\n(", main_oeuvre, "%)']
E [label = 'Hors main\\nd\\'oeuvre (", hors_main_oeuvre, "%)']
F [label = 'Population en\\nemploi (", emploi, "%)']
G [label = 'Chômage (", chomage, "%)']
H [label = 'Main d\\'oeuvre\\npotentielle (", main_oeuvre_pot, "%)']
I [label = 'Population au\\ntravail mais pas en\\nemploi (", travail_pas_emploi, "%)']
J [label = 'Autres individus\\nhors main\\nd\\'oeuvre (", autres_hors_main, "%)']
A -> B
A -> C
C -> D
C -> E
D -> F
D -> G
E -> H
E -> I
E -> J
{rank = same; B; C}
{rank = same; D; E}
{rank = same; F; G; H; I; J}
}
"))
return(diagram)
}
# Exemple d'utilisation avec les données du diagramme
donnees_population <- list(
pop_age_travail = 62.5,
main_oeuvre = 55.7,
hors_main_oeuvre = 44.3,
emploi = 94.7,
chomage = 5.3,
main_oeuvre_pot = 5.7,
travail_pas_emploi = 78.7,
autres_hors_main = 15.6
)
# Générer le diagramme avec les données par défaut
diagramme_population <- create_population_diagram()
diagramme_population
# Générer le diagramme avec des données personnalisées
diagramme_avec_donnees <- create_population_diagram_with_data(donnees_population)
diagramme_avec_donnees
print("Diagramme créé avec succès!")
print("Utilisez 'diagramme_population' pour voir le diagramme avec les valeurs par défaut")
print("Utilisez 'diagramme_avec_donnees' pour voir le diagramme avec vos données personnalisées")
print("Modifiez la liste 'donnees_population' pour utiliser vos propres données")
