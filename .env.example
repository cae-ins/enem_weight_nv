# Modèle de .env (copier en .env à la racine du dépôt, ne jamais commiter .env).
# Aucune valeur réelle ici : les identifiants MinIO se demandent à l'administrateur.

# MinIO (lu par scripts/medallion/medallion.py et ENE_MEDALLION_ORCHESTRATION)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=

# Période traitée (format TX_AAAA) ; remplace TARGET_QUARTER de config/1_config.r
ENE_QUARTER=
# Publication annuelle : ENE_PERIOD=annual et ENE_YEAR=<année>
ENE_PERIOD=
ENE_YEAR=
ENE_CALIBRATION_STRATEGY=180X_1D

# Facultatif
# ENE_BASE_DIR=            racine du dépôt si R n'est pas lancé depuis celle-ci
# ENE_ORCHESTRATION_ROOT=  dépôt ENE_MEDALLION_ORCHESTRATION s'il n'est pas à côté de celui-ci
# ENE_PYTHON=              interpréteur Python appelé depuis R
# ENE_RGPH_SAV=            fichier brut du RGPH 2021 (01_utils/extract_rp2021_vars.R)
# ENE_LONGITUDINAL_INPUT=  base empilée du module 12_longitudinal_weights
